<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FuxiangConsole.Pages.ShotPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="20,16,20,20">
        <StackPanel Spacing="12" MaxWidth="1150" HorizontalAlignment="Left">
            <TextBlock Text="引擎截图" FontSize="24" FontWeight="SemiBold"/>

            <Border Style="{StaticResource Card}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BtnTop" Content="拍一张俯视图" Click="BtnTop_Click"/>
                    <Button Content="拍一套多角度（5张）" Click="BtnSweep_Click"/>
                    <Button Content="画一张平面图" Click="BtnLayout_Click"/>
                    <Button Content="还原游戏视角" Click="BtnRestore_Click"/>
                    <TextBlock Text="截图只临时移动游戏视角，拍完自动还原；保存在 preview\shots\" FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="图库（新→旧）" FontWeight="SemiBold"/>
                            <Button Content="刷新" FontSize="11" Padding="8,2" HorizontalAlignment="Right" Click="BtnReload_Click"/>
                        </Grid>
                        <ScrollViewer MaxHeight="560">
                            <ListView x:Name="ShotList" SelectionMode="Single" SelectionChanged="ShotList_SelectionChanged"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="预览" FontWeight="SemiBold"/>
                        <Image x:Name="BigImage" MinHeight="380" Stretch="Uniform"/>
                        <TextBlock x:Name="BigCaption" FontSize="12" Foreground="Gray"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="任务日志" FontWeight="SemiBold"/>
            <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     Height="150" FontFamily="Cascadia Mono" FontSize="12"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        </StackPanel>
    </ScrollViewer>
</Page>
