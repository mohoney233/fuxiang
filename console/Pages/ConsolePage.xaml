<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FuxiangConsole.Pages.ConsolePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="20,16,20,20">
        <StackPanel Spacing="12" MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Text="高级（开发者）" FontSize="24" FontWeight="SemiBold"/>

            <InfoBar Severity="Warning" Title="这是给开发者用的工具" IsOpen="True" IsClosable="True"
                     Message="普通使用不需要这一页。这里可以调用编辑器的底层接口和执行 Python，用错可能影响地图，请确认你知道自己在做什么。"/>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="edit op 调用（与 cli/fxedit.py 同链路）" FontWeight="SemiBold"/>
                    <AutoSuggestBox x:Name="OpBox" PlaceholderText="op 名，如 map_info"
                                    TextChanged="OpBox_TextChanged"
                                    QuerySubmitted="OpRun_Click">
                        <AutoSuggestBox.QueryIcon>
                            <SymbolIcon Symbol="Find"/>
                        </AutoSuggestBox.QueryIcon>
                    </AutoSuggestBox>
                    <TextBox x:Name="ArgsBox" Header="JSON 参数" PlaceholderText="{}{&quot;query&quot;:&quot;桌子&quot;,&quot;limit&quot;:3}"
                             AcceptsReturn="True" TextWrapping="NoWrap" Height="72"
                             FontFamily="Cascadia Mono" FontSize="12"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BtnOpRun" Content="执行 op" Click="OpRun_Click"/>
                        <ProgressRing x:Name="OpRing" IsActive="False" Width="22" Height="22"/>
                    </StackPanel>
                    <TextBlock Text="常用：" FontSize="12" Foreground="Gray"/>
                    <StackPanel x:Name="PresetPanel" Orientation="Horizontal" Spacing="6"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="eval（Python 逃生舱；桥接层预置 core / room / cm / em / GK）" FontWeight="SemiBold"/>
                    <TextBox x:Name="EvalBox" AcceptsReturn="True" TextWrapping="NoWrap" Height="120"
                             FontFamily="Cascadia Mono" FontSize="12" PlaceholderText="__result__ = str(room)"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <CheckBox x:Name="EvalJsonChk" Content="__result__ 按 JSON 解析" IsChecked="True"/>
                        <Button x:Name="BtnEvalRun" Content="执行 eval" Click="EvalRun_Click"/>
                        <ProgressRing x:Name="EvalRing" IsActive="False" Width="22" Height="22"/>
                        <TextBlock Text="高危：在游戏主线程执行任意 Python" FontSize="12" Foreground="OrangeRed" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="命令手册（点一条自动填到上面）" FontWeight="SemiBold"/>
                    <TextBox x:Name="ManualSearch" PlaceholderText="搜索命令名或作用，如：保存 / story / 属性"
                             TextChanged="ManualSearch_TextChanged"/>
                    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ManualList" Spacing="8"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="结果" FontWeight="SemiBold"/>
                        <TextBox x:Name="ResultBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                 Height="260" FontFamily="Cascadia Mono" FontSize="12"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="历史" FontWeight="SemiBold"/>
                            <Button x:Name="BtnClearHist" Content="清空" HorizontalAlignment="Right" Click="BtnClearHist_Click"/>
                        </Grid>
                        <ListView x:Name="HistList" MaxHeight="260" SelectionMode="Single"
                                  SelectionChanged="Hist_SelectionChanged"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
