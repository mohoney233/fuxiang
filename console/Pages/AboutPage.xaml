<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FuxiangConsole.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="20,16,20,20">
        <StackPanel Spacing="16" MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Text="关于" FontSize="24" FontWeight="SemiBold"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="6">
                    <TextBlock Text="随笔浮想 · 桥接控制台" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionText" FontSize="13" Opacity="0.8"/>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="10">
                    <TextBlock Text="作者信息" FontSize="16" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="B 站：bilibili@残雪Ethereal" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="邮箱：" FontSize="14"/>
                        <HyperlinkButton Content="mohoney0@qq.com" Padding="0" Margin="0"
                                         NavigateUri="mailto:mohoney0@qq.com"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="10">
                    <TextBlock Text="使用声明" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap" FontSize="14"
                               Text="该编辑器为个人学习研究制作，禁止用于商业用途，不得付费倒卖。"/>
                    <InfoBar Severity="Warning" IsOpen="True" IsClosable="False"
                             Title="如果你是付费获取的该应用，请联系作者"
                             Message="本工具免费分享；任何收费分发都与作者无关，请通过上方邮箱联系作者反馈。"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
