<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FuxiangConsole.Pages.EventPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="20,16,20,20">
        <StackPanel Spacing="12" MaxWidth="1150" HorizontalAlignment="Left">
            <TextBlock Text="事件管理" FontSize="24" FontWeight="SemiBold"/>

            <InfoBar Severity="Informational" IsOpen="True" IsClosable="False"
                     Title="事件 = 物件之间的联动规则"
                     Message="比如「走进区域 → 弹出提示」。这里可以把当前地图的事件导出成文件留档，也可以把事件文件导入回来。导入默认只预览，确认后才会真正改动。"/>

            <Border Style="{StaticResource Card}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BtnExport" Content="导出当前地图的事件" Click="BtnExport_Click"/>
                    <Button Content="查看导出的文件" Click="BtnRead_Click"/>
                    <Button Content="生成物件标签" Click="BtnLabelsDump_Click"/>
                    <Button Content="检查标签" Click="BtnLabelsCheck_Click"/>
                    <Button Content="选择事件文件…" Click="BtnPick_Click"/>
                </StackPanel>
            </Border>

            <InfoBar x:Name="ResultBar" Severity="Success" IsOpen="False"/>

            <!-- 友好摘要：默认展示 -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" FontSize="15">
                        <Run Text="这张地图的事件"/>
                        <Run x:Name="SrcName" Foreground="Gray" FontSize="12"/>
                    </TextBlock>
                    <TextBlock x:Name="FriendlySummary" Text="还没有导出。点上方「导出当前地图的事件」。"
                               FontSize="13.5" TextWrapping="Wrap"/>
                    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="FriendlyList" Spacing="8"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Expander Header="技术详情（原始导出数据）" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                <TextBox x:Name="EventView" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         Height="330" Margin="0,6" FontFamily="Cascadia Mono" FontSize="12"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            </Expander>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="430"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="从文件导入事件" FontWeight="SemiBold"/>
                        <ComboBox x:Name="ImportFile" HorizontalAlignment="Stretch"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <CheckBox x:Name="ImportApply" Content="真正导入（否则只预览）"/>
                            <CheckBox x:Name="ImportPrune" Content="删除文件里没有的绑定"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="TolBox" Header="对位容差" Text="2" Width="90"/>
                            <Button Content="开始导入" Click="BtnImport_Click"/>
                        </StackPanel>
                        <TextBlock FontSize="12" Foreground="Gray" TextWrapping="Wrap"
                                   Text="导入按物件的位置和类型对上号，事件内容原样写回。导入完成后会提醒你保存地图。"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="高级：DSL 转换" FontWeight="SemiBold"/>
                        <ComboBox x:Name="DslSrc" HorizontalAlignment="Stretch"/>
                        <TextBox x:Name="DslDst" Header="DSL 文件名" Text="events.yaml"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="转成人读格式" Click="BtnDslTo_Click"/>
                            <Button Content="从人读格式转回" Click="BtnDslFrom_Click"/>
                        </StackPanel>
                        <TextBlock FontSize="12" Foreground="Gray" TextWrapping="Wrap"
                                   Text="本机 Python 未装 PyYAML 时 DSL 自动退化为 JSON 格式。"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="任务日志" FontWeight="SemiBold"/>
            <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     Height="170" FontFamily="Cascadia Mono" FontSize="12"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        </StackPanel>
    </ScrollViewer>
</Page>
